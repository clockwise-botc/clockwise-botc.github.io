/**
 * Clockwise shared store — Google Apps Script.
 * Generated by scripts/build-backend.mjs from backend/ and extension/src/; edit those, not this file.
 *
 * Setup (once):
 *   1. Create a Google Sheet. Extensions → Apps Script. Replace everything in Code.gs with this file and save.
 *   2. Project Settings (gear) → Script properties → add three properties:
 *        VIEW_PASSWORD  the password you'll share with your community
 *        WRITE_KEY      the upload key built into the extension
 *        EDITOR_KEY     a key for people allowed to change or delete games
 *   3. Deploy → New deployment → type "Web app". Execute as: Me. Who has access: Anyone. Authorize when asked.
 *   4. Copy the web app URL (ends in /exec).
 * To update later: paste the new file, then Deploy → Manage deployments → edit → Version: New version.
 */

// ----- extension/src/communities.js -----
// Communities group games across rooms (e.g. Escape always plays in "escape"; Rhap uses a new room each time).
// A game's community is decided by, in order:
//   1. a manual choice for that room (popup), stored in settings.roomCommunity
//   2. a community whose room list includes the room
//   3. the default community for every other room
// A game can also have no community at all (null): the user switched the selection off. There is
// no "No community" option anywhere in the UI; internally NONE marks "switched off" for a room.

const NONE = 'none';

const DEFAULTS = {
  communities: [
    { id: 'escape', name: 'Escape', rooms: ['escape'] },
    { id: 'rhap', name: 'Rhap', rooms: [] },
  ],
  fallbackCommunity: 'rhap',
};

const norm = (room) => String(room || '').trim().toLowerCase();

function communityConfig(settings = {}) {
  return {
    communities: Array.isArray(settings.communities) ? settings.communities : DEFAULTS.communities,
    fallback: settings.fallbackCommunity !== undefined ? settings.fallbackCommunity : DEFAULTS.fallbackCommunity,
    overrides: settings.roomCommunity || {},
  };
}

// The community a room gets without a manual choice.
function automaticCommunity(settings, room) {
  const cfg = communityConfig(settings);
  const r = norm(room);
  const match = cfg.communities.find((c) => (c.rooms || []).some((x) => norm(x) === r));
  if (match) return match.id;
  return cfg.fallback && cfg.fallback !== NONE && cfg.communities.some((c) => c.id === cfg.fallback) ? cfg.fallback : null;
}

// The community for a room, honouring a manual choice. Returns a community id, or null for "no community".
function communityForRoom(settings, room) {
  const choice = communityConfig(settings).overrides[norm(room)];
  if (choice === NONE) return null;
  if (choice && communityConfig(settings).communities.some((c) => c.id === choice)) return choice;
  return automaticCommunity(settings, room);
}

function isManual(settings, room) {
  return communityConfig(settings).overrides[norm(room)] !== undefined;
}

// Returns new settings with the room's manual choice set (communityId, NONE) or cleared (null).
function withRoomChoice(settings, room, choice) {
  const overrides = { ...(settings.roomCommunity || {}) };
  if (choice === null || choice === undefined) delete overrides[norm(room)];
  else overrides[norm(room)] = choice;
  return { ...settings, roomCommunity: overrides };
}

function communityName(settings, id) {
  if (!id || id === NONE) return '';
  const c = communityConfig(settings).communities.find((x) => x.id === id);
  return c ? c.name : id;
}

// Games saved before communities existed get one from their room.
function gameCommunity(settings, game) {
  return game.community !== undefined ? game.community : communityForRoom(settings, game.room);
}

function slug(name, taken) {
  const base = norm(name).replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'community';
  let id = base;
  for (let i = 2; taken.includes(id); i++) id = `${base}-${i}`;
  return id;
}

// ----- extension/src/tables.js -----
// Flattens game records into tidy tables (one row per game / player / nomination / death).
// Used for CSV export and Google Sheets sync, so both always have identical columns.


const iso = (ms) => (ms ? new Date(ms).toISOString() : '');
const names = (list) => (list || []).map((x) => x.username || x.name || x.userId || x.id).filter(Boolean).join(', ');
const playerName = (p) => p.username || (p.userId ? p.userId : `Seat ${p.seat}`);

const COLUMNS = {
  games: ['game_id', 'community', 'room', 'started_at', 'ended_at', 'duration_min', 'script_id', 'script_name', 'official_script', 'winner',
    'storytellers', 'player_count', 'traveller_count', 'days', 'fabled', 'demons', 'minions', 'outsiders', 'bluffs', 'nominations', 'deaths', 'captured_by', 'excluded'],
  game_players: ['game_id', 'community', 'ended_at', 'script_name', 'winner', 'seat', 'player', 'user_id', 'role_id', 'role', 'team', 'alignment',
    'starting_role', 'role_changed', 'traveller', 'survived', 'died_day', 'died_at_night', 'dead_vote_used', 'reminders', 'won', 'player_count', 'excluded'],
  nominations: ['game_id', 'community', 'ended_at', 'day', 'nominator', 'nominator_seat', 'nominator_role', 'nominee', 'nominee_seat', 'nominee_role',
    'type', 'completed', 'votes', 'majority', 'reached_majority', 'voters', 'excluded'],
  deaths: ['game_id', 'community', 'ended_at', 'day', 'at_night', 'phase', 'player', 'seat', 'role', 'team', 'alignment', 'excluded'],
};

function toTables(games, settings = {}) {
  const t = { games: [], game_players: [], nominations: [], deaths: [] };
  for (const g of games) {
    const bySeat = new Map(g.players.map((p) => [p.seat, p]));
    const roleAt = (seat) => (bySeat.get(seat) || {}).roleName || '';
    const ex = !!g.excluded;
    const cid = gameCommunity(settings, g);
    const community = cid ? communityName(settings, cid) : '';
    t.games.push({
      game_id: g.id,
      community,
      room: g.room,
      started_at: iso(g.startedAt),
      ended_at: iso(g.endedAt),
      duration_min: g.startedAt && g.endedAt ? Math.round((g.endedAt - g.startedAt) / 60000) : '',
      script_id: g.script.id || '',
      script_name: g.script.name || '',
      official_script: !!g.script.isOfficial,
      winner: g.winner,
      storytellers: names(g.storytellers),
      player_count: g.playerCount,
      traveller_count: g.travellerCount,
      days: g.days,
      fabled: names(g.fabled),
      demons: g.players.filter((p) => p.team === 'demon').map((p) => p.roleName).join(', '),
      minions: g.players.filter((p) => p.team === 'minion').map((p) => p.roleName).join(', '),
      outsiders: g.players.filter((p) => p.team === 'outsider').map((p) => p.roleName).join(', '),
      bluffs: (g.bluffs || []).map((b) => b.name).join(', '),
      nominations: g.nominations.length,
      deaths: g.deaths.length,
      captured_by: (g.capturedBy && g.capturedBy.username) || '',
      excluded: ex,
    });
    for (const p of g.players) {
      t.game_players.push({
        game_id: g.id,
        community,
        ended_at: iso(g.endedAt),
        script_name: g.script.name || '',
        winner: g.winner,
        seat: p.seat,
        player: playerName(p),
        user_id: p.userId || '',
        role_id: p.roleId || '',
        role: p.roleName || '',
        team: p.team || '',
        alignment: p.alignment || '',
        starting_role: p.startingRoleName || '',
        role_changed: !!(p.startingRoleId && p.startingRoleId !== p.roleId),
        traveller: p.isTraveller,
        survived: p.survived,
        died_day: p.diedPhase ? Math.ceil(p.diedPhase / 2) : '',
        died_at_night: p.diedPhase ? p.diedPhase % 2 === 1 : '',
        dead_vote_used: !!p.deadVoteUsed,
        reminders: (p.reminders || []).map((r) => (r.source ? `${r.source}: ${r.name}` : r.name)).join('; '),
        won: p.won === null ? '' : p.won,
        player_count: g.playerCount,
        excluded: ex,
      });
    }
    for (const n of g.nominations) {
      t.nominations.push({
        game_id: g.id,
        community,
        ended_at: iso(g.endedAt),
        day: n.day,
        nominator: n.nominator || `Seat ${n.nominatorSeat}`,
        nominator_seat: n.nominatorSeat,
        nominator_role: roleAt(n.nominatorSeat),
        nominee: n.nominee || `Seat ${n.nomineeSeat}`,
        nominee_seat: n.nomineeSeat,
        nominee_role: roleAt(n.nomineeSeat),
        type: n.type,
        completed: n.completed,
        votes: n.votes === null ? '' : n.votes,
        majority: n.majority,
        reached_majority: n.votes === null ? '' : n.votes >= n.majority,
        voters: (n.voters || []).map((v) => v.username || `Seat ${v.seat}`).join(', '),
        excluded: ex,
      });
    }
    for (const d of g.deaths) {
      const p = bySeat.get(d.seat) || {};
      t.deaths.push({
        game_id: g.id,
        community,
        ended_at: iso(g.endedAt),
        day: d.phase ? Math.ceil(d.phase / 2) : '',
        at_night: d.phase ? d.phase % 2 === 1 : '',
        phase: d.phase === null ? '' : d.phase,
        player: d.username || p.username || `Seat ${d.seat}`,
        seat: d.seat,
        role: p.roleName || '',
        team: p.team || '',
        alignment: p.alignment || '',
        excluded: ex,
      });
    }
  }
  return t;
}

function toCSV(rows, columns) {
  const esc = (v) => {
    const s = v === null || v === undefined ? '' : String(v);
    return /[",\n\r]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
  };
  return [columns.join(','), ...rows.map((r) => columns.map((c) => esc(r[c])).join(','))].join('\r\n');
}

// ----- backend/server.js -----
// Clockwise shared store: request handling, kept apart from storage so the same code runs in Apps Script (with
// the Google Sheet store in sheets-store.js) and in local tests (with an in-memory store).
//
// Every request is a POST with a JSON body { action, key, ... }. Keys:
//   VIEW_PASSWORD  read games (the community password)
//   WRITE_KEY      upload recorded games and botc.app art info (built into the extension)
//   EDITOR_KEY     everything, including edits and deletes
// Several people can record the same game: its id ("room:start time") is the same for everyone in the room, so
// uploads of one game are merged into a single record (see mergeGame_).

// Fields a viewer can change after the fact. Kept separately from the recorded data so a later upload of the same
// game never undoes a fix.
var EDITABLE_ = ['community', 'communityManual', 'excluded', 'notes', 'storytellers', 'names'];

function handle_(body, store, keys, now) {
  var key = String((body && body.key) || '');
  var is = function (k) { return !!k && key === k; };
  var canRead = is(keys.view) || is(keys.editor);
  var canWrite = is(keys.write) || is(keys.editor);
  var canEdit = is(keys.editor);
  var deny = function (what) { return { ok: false, error: 'not-allowed', message: 'That key or password can\'t ' + what + '.' }; };

  switch (body && body.action) {
    case 'ping':
      return { ok: true, canRead: canRead, canWrite: canWrite, canEdit: canEdit, now: now };

    case 'record': {
      if (!canWrite) return deny('upload games');
      var games = Array.isArray(body.games) ? body.games : [];
      var saved = [], skipped = [];
      store.batch(function () {
        games.forEach(function (raw) {
          var g = cleanGame_(raw);
          if (!g || !g.id) return;
          if (store.isDeleted(g.id)) { skipped.push(g.id); return; }
          var merged = mergeGame_(store.getRecord(g.id), g);
          store.putRecord(g.id, merged, now);
          saved.push(g.id);
        });
        if (saved.length) store.refreshTables(saved);
      });
      return { ok: true, saved: saved, skipped: skipped, now: now };
    }

    case 'void': {
      // A recorder taking back a game whose ending the storyteller cancelled. Only removes it if nobody else
      // recorded it, and doesn't stop it being recorded again when the game really ends.
      if (!canWrite) return deny('withdraw games');
      var rec = store.getRecord(body.id);
      var who = String(body.recorder || '');
      if (!rec) return { ok: true, removed: false };
      var others = (rec.recorders || []).filter(function (r) { return r !== who; });
      if (others.length) return { ok: true, removed: false };
      store.batch(function () { store.removeRecord(body.id); store.refreshTables([body.id]); });
      return { ok: true, removed: true };
    }

    case 'meta': {
      if (!canWrite) return deny('upload artwork');
      var meta = body.meta || {};
      var old = store.getMeta() || {};
      // Each part is kept until a newer one arrives; the character list grows as people see more characters.
      var next = {
        assetMap: meta.assetMap && meta.assetMap.map ? meta.assetMap : old.assetMap || null,
        tokenStyle: meta.tokenStyle && meta.tokenStyle.variants ? meta.tokenStyle : old.tokenStyle || null,
        roleMeta: Object.assign({}, old.roleMeta || {}, meta.roleMeta || {}),
      };
      store.putMeta(next, now);
      return { ok: true, now: now };
    }

    case 'edit': {
      if (!canEdit) return deny('change games');
      if (!body.id || !store.getRecord(body.id)) return { ok: false, error: 'not-found' };
      var patch = {};
      EDITABLE_.forEach(function (f) { if (body.patch && f in body.patch) patch[f] = body.patch[f]; });
      var prev = store.getEdit(body.id) || {};
      if (patch.names) patch.names = Object.assign({}, prev.names || {}, patch.names);
      store.putEdit(body.id, Object.assign({}, prev, patch), now);
      store.refreshTables([body.id]);
      return { ok: true, now: now };
    }

    case 'delete': {
      if (!canEdit) return deny('delete games');
      var ids = [].concat(body.ids || body.id || []);
      store.batch(function () { ids.forEach(function (id) { store.markDeleted(id, now); }); store.refreshTables(ids); });
      return { ok: true, deleted: ids, now: now };
    }

    case 'read': {
      if (!canRead) return deny('see games');
      var since = Number(body.since) || 0;
      var out = [];
      var ids = store.changedSince(since);
      var recs = store.getRecords(ids);
      ids.forEach(function (id) { if (recs[id]) out.push(withEdits_(recs[id], store.getEdit(id))); });
      var metaInfo = store.getMetaInfo();
      return {
        ok: true, now: now, since: since,
        games: out,
        deleted: store.deletedSince(since),
        meta: metaInfo && metaInfo.at > since ? store.getMeta() : null,
        canEdit: canEdit,
      };
    }

    default:
      return { ok: false, error: 'unknown-action' };
  }
}

// What a recorder uploads, minus things that are personal to their browser or can be worked out again.
function cleanGame_(raw) {
  if (!raw || typeof raw !== 'object' || typeof raw.id !== 'string' || /^sample-/.test(raw.id)) return null;
  var g = JSON.parse(JSON.stringify(raw));
  ['syncedAt', 'excluded', 'notes', 'communityManual'].forEach(function (f) { delete g[f]; });
  var botcArt = function (u) { return typeof u === 'string' && /^https:\/\/botc\.app\/assets\//.test(u); };
  (g.players || []).forEach(function (p) {
    if (botcArt(p.icon)) delete p.icon;
    (p.reminders || []).forEach(function (r) { if (botcArt(r.icon)) delete r.icon; });
  });
  ['bluffs', 'fabled'].forEach(function (k) { (g[k] || []).forEach(function (x) { if (botcArt(x.icon)) delete x.icon; }); });
  return g;
}

// How complete a recording is: someone who was there from the start, saw more nominations and deaths, and has more
// names and characters filled in wins.
function completeness_(g) {
  var players = g.players || [];
  return [
    -(Number(g.joinedAtPhase) || 0),
    (g.nominations || []).length + (g.deaths || []).length,
    players.reduce(function (n, p) { return n + (p.reminders || []).length; }, 0),
    players.filter(function (p) { return p.username; }).length + players.filter(function (p) { return p.roleId; }).length,
    (g.storytellers || []).filter(function (s) { return s.username; }).length,
  ];
}

function better_(a, b) {
  var x = completeness_(a), y = completeness_(b);
  for (var i = 0; i < x.length; i++) if (x[i] !== y[i]) return x[i] > y[i];
  return false; // a tie keeps what's already stored
}

// Two recordings of one game → one record: the more complete one, with gaps filled from the other.
function mergeGame_(stored, incoming) {
  if (!stored) return Object.assign({}, incoming, { recorders: recorderList_([], incoming) });
  var main = better_(incoming, stored) ? incoming : stored;
  var other = main === incoming ? stored : incoming;
  var out = JSON.parse(JSON.stringify(main));
  var bySeat = {};
  (other.players || []).forEach(function (p) { bySeat[p.seat] = p; });
  (out.players || []).forEach(function (p) {
    var o = bySeat[p.seat];
    if (!o) return;
    ['username', 'userId', 'roleId', 'roleName', 'team', 'alignment', 'startingRoleId', 'startingRoleName'].forEach(function (f) {
      if ((p[f] === null || p[f] === undefined || p[f] === '') && o[f]) p[f] = o[f];
    });
    if (!(p.reminders || []).length && (o.reminders || []).length) p.reminders = o.reminders;
  });
  if (!(out.storytellers || []).some(function (s) { return s.username; }) && (other.storytellers || []).length) out.storytellers = other.storytellers;
  ['bluffs', 'fabled', 'background'].forEach(function (k) {
    var empty = !out[k] || (Array.isArray(out[k]) && !out[k].length);
    if (empty && other[k]) out[k] = other[k];
  });
  // A community the recorder picked for this game in the extension's popup beats the automatic one.
  if (incoming.communityChosen && incoming.community) out.community = incoming.community;
  out.recorders = recorderList_(stored.recorders || recorderList_([], stored), incoming);
  return out;
}

function recorderList_(list, g) {
  var name = g && g.capturedBy && (g.capturedBy.username || g.capturedBy.userId);
  var out = list.slice();
  if (name && out.indexOf(name) === -1) out.push(name);
  return out;
}

// A record as viewers see it: the recording with any fixes applied on top.
function withEdits_(rec, edit) {
  if (!edit) return rec;
  var g = JSON.parse(JSON.stringify(rec));
  ['community', 'communityManual', 'excluded', 'notes', 'storytellers'].forEach(function (f) { if (f in edit) g[f] = edit[f]; });
  if (edit.names) {
    (g.players || []).forEach(function (p) {
      var n = edit.names[p.seat];
      if (n && n.username) { p.username = n.username; if (n.userId) p.userId = n.userId; }
    });
  }
  return g;
}

// ----- backend/sheets-store.js -----
// Google Sheet storage for the shared store (Apps Script only). Tabs:
//   records  game_id | updated_at | ended_at | recorders | parts | data…   one row per game, JSON gzipped + base64,
//                                                                      split over cells (a cell holds 50,000 chars)
//   edits    game_id | updated_at | json                                fixes made by editors
//   deleted  game_id | deleted_at                                       so deleted games aren't uploaded again
//   meta     key | updated_at | parts | data…                           botc.app art info for the website
//   games, game_players, nominations, deaths                             tidy tables for working in the Sheet

var CHUNK_ = 45000;

function sheetStore_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var tab = function (name, header) {
    var sh = ss.getSheetByName(name);
    if (!sh) {
      sh = ss.insertSheet(name);
      sh.getRange(1, 1, 1, header.length).setValues([header]).setFontWeight('bold');
      sh.setFrozenRows(1);
    }
    return sh;
  };
  var records = tab('records', ['game_id', 'updated_at', 'ended_at', 'recorders', 'parts', 'data']);
  var edits = tab('edits', ['game_id', 'updated_at', 'json']);
  var deleted = tab('deleted', ['game_id', 'deleted_at']);
  var metaSheet = tab('meta', ['key', 'updated_at', 'parts', 'data']);

  // Small index of every record (no game data), read once per request.
  var rows = function (sh, width) {
    var n = sh.getLastRow() - 1;
    return n > 0 ? sh.getRange(2, 1, n, width).getValues() : [];
  };
  var index = {};
  rows(records, 5).forEach(function (r, i) { if (r[0]) index[r[0]] = { row: i + 2, at: Number(r[1]) || 0, parts: Number(r[4]) || 0 }; });
  var editRows = {};
  rows(edits, 3).forEach(function (r, i) { if (r[0]) editRows[r[0]] = { row: i + 2, at: Number(r[1]) || 0, json: r[2] }; });
  var gone = {};
  rows(deleted, 2).forEach(function (r) { if (r[0]) gone[r[0]] = Number(r[1]) || 0; });
  var cache = {};

  var pack = function (obj) {
    var b64 = Utilities.base64Encode(Utilities.gzip(Utilities.newBlob(JSON.stringify(obj), 'application/json')).getBytes());
    var parts = [];
    for (var i = 0; i < b64.length; i += CHUNK_) parts.push(b64.slice(i, i + CHUNK_));
    return parts;
  };
  var unpack = function (parts) {
    var b64 = parts.join('');
    if (!b64) return null;
    var blob = Utilities.newBlob(Utilities.base64Decode(b64), 'application/x-gzip');
    return JSON.parse(Utilities.ungzip(blob).getDataAsString());
  };
  var writeRow = function (sh, row, lead, parts, oldParts) {
    var cells = lead.concat(parts);
    // Blank any chunk cells left over from a longer previous version.
    for (var i = parts.length; i < (oldParts || 0); i++) cells.push('');
    if (sh.getMaxColumns() < cells.length) sh.insertColumnsAfter(sh.getMaxColumns(), cells.length - sh.getMaxColumns());
    sh.getRange(row, 1, 1, cells.length).setValues([cells]);
  };

  var store = {
    batch: function (fn) {
      var lock = LockService.getScriptLock();
      lock.waitLock(30000);
      try { fn(); SpreadsheetApp.flush(); } finally { lock.releaseLock(); }
    },
    isDeleted: function (id) { return id in gone; },
    getRecord: function (id) {
      if (id in cache) return cache[id];
      var ix = index[id];
      if (!ix || !ix.parts) return null;
      cache[id] = unpack(records.getRange(ix.row, 6, 1, ix.parts).getValues()[0]);
      return cache[id];
    },
    // Many records at once (a dashboard's first download): one bulk read instead of a read per game.
    getRecords: function (ids) {
      var out = {};
      if (ids.length > 20 && records.getLastRow() > 1) {
        var width = Math.max(6, records.getLastColumn());
        var all = records.getRange(2, 1, records.getLastRow() - 1, width).getValues();
        var want = {};
        ids.forEach(function (id) { want[id] = true; });
        all.forEach(function (r) { if (want[r[0]] && r[4]) out[r[0]] = unpack(r.slice(5, 5 + Number(r[4]))); });
      } else ids.forEach(function (id) { var g = store.getRecord(id); if (g) out[id] = g; });
      return out;
    },
    putRecord: function (id, rec, now) {
      var parts = pack(rec);
      var ix = index[id];
      var row = ix ? ix.row : records.getLastRow() + 1;
      writeRow(records, row, [id, now, rec.endedAt || '', (rec.recorders || []).join(', '), parts.length], parts, ix && ix.parts);
      index[id] = { row: row, at: now, parts: parts.length };
      cache[id] = rec;
    },
    getEdit: function (id) {
      var e = editRows[id];
      return e && e.json ? JSON.parse(e.json) : null;
    },
    putEdit: function (id, edit, now) {
      var e = editRows[id];
      var row = e ? e.row : edits.getLastRow() + 1;
      var json = JSON.stringify(edit);
      edits.getRange(row, 1, 1, 3).setValues([[id, now, json]]);
      editRows[id] = { row: row, at: now, json: json };
    },
    markDeleted: function (id, now) {
      if (!(id in gone)) deleted.appendRow([id, now]);
      gone[id] = now;
      var ix = index[id];
      if (ix) { records.getRange(ix.row, 1, 1, Math.max(6, records.getLastColumn())).clearContent(); delete index[id]; delete cache[id]; }
    },
    removeRecord: function (id) {
      var ix = index[id];
      if (ix) { records.getRange(ix.row, 1, 1, Math.max(6, records.getLastColumn())).clearContent(); delete index[id]; delete cache[id]; }
    },
    changedSince: function (since) {
      var ids = {};
      Object.keys(index).forEach(function (id) { if (index[id].at > since) ids[id] = true; });
      Object.keys(editRows).forEach(function (id) { if (editRows[id].at > since && index[id]) ids[id] = true; });
      return Object.keys(ids).filter(function (id) { return !(id in gone); });
    },
    deletedSince: function (since) { return Object.keys(gone).filter(function (id) { return gone[id] > since; }); },
    getMetaInfo: function () {
      var r = rows(metaSheet, 3).filter(function (x) { return x[0] === 'meta'; })[0];
      return r ? { at: Number(r[1]) || 0, parts: Number(r[2]) || 0 } : null;
    },
    getMeta: function () {
      var info = store.getMetaInfo();
      if (!info || !info.parts) return null;
      return unpack(metaSheet.getRange(2, 4, 1, info.parts).getValues()[0]);
    },
    putMeta: function (meta, now) {
      var info = store.getMetaInfo();
      var parts = pack(meta);
      writeRow(metaSheet, 2, ['meta', now, parts.length], parts, info && info.parts);
    },
    // Rebuild the tidy tabs' rows for these games (so the Sheet stays handy for your own analysis).
    refreshTables: function (ids) {
      var live = [];
      ids.forEach(function (id) {
        if (id in gone) return;
        var g = store.getRecord(id);
        if (g) live.push(withEdits_(g, store.getEdit(id)));
      });
      var tables = toTables(live, {});
      var drop = {};
      ids.forEach(function (id) { drop[id] = true; });
      Object.keys(COLUMNS).forEach(function (name) {
        var sh = tab(name, COLUMNS[name]);
        var n = sh.getLastRow() - 1;
        if (n > 0) {
          var values = sh.getRange(2, 1, n, COLUMNS[name].length).getValues();
          var keep = values.filter(function (r) { return !drop[r[0]]; });
          if (keep.length !== values.length) {
            sh.getRange(2, 1, n, COLUMNS[name].length).clearContent();
            if (keep.length) sh.getRange(2, 1, keep.length, COLUMNS[name].length).setValues(keep);
          }
        }
        var add = tables[name].map(function (r) { return COLUMNS[name].map(function (c) { return r[c] === undefined || r[c] === null ? '' : r[c]; }); });
        if (add.length) {
          var start = Math.max(sh.getLastRow(), 1) + 1;
          sh.getRange(start, 1, add.length, COLUMNS[name].length).setValues(add);
        }
      });
    },
  };
  return store;
}

// ----- backend/main.js -----
// Apps Script entry points. The keys are Script properties (Project Settings → Script properties), not code, so
// they can be changed without editing this file: VIEW_PASSWORD, WRITE_KEY, EDITOR_KEY.

function keys_() {
  var p = PropertiesService.getScriptProperties();
  return { view: p.getProperty('VIEW_PASSWORD') || '', write: p.getProperty('WRITE_KEY') || '', editor: p.getProperty('EDITOR_KEY') || '' };
}

// Opening the web app's address in a browser just confirms it's running; games are only ever sent in response
// to a POST with the right password.
function doGet() {
  var k = keys_();
  return json_({ ok: true, service: 'clockwise', ready: !!(k.view && k.write && k.editor) });
}

function doPost(e) {
  var body;
  try {
    body = JSON.parse(e.postData.contents);
  } catch (err) {
    return json_({ ok: false, error: 'bad-request' });
  }
  try {
    return json_(handle_(body, sheetStore_(), keys_(), Date.now()));
  } catch (err) {
    return json_({ ok: false, error: 'server-error', message: String(err && err.message || err) });
  }
}

function json_(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}
